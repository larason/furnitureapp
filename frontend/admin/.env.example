# Client-safe Clerk instance configuration.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=

# Server-only Clerk configuration for server-side session resolution. Never commit a value.
CLERK_SECRET_KEY=

# Bare canonical admin origin; do not guess the production domain.
NEXT_PUBLIC_ADMIN_ORIGIN=http://localhost:3001

# Server-only Laravel API origin, without /api/v1.
API_BASE_URL=http://127.0.0.1:8000

# Server-only public media origin Laravel builds product image URLs from. Must be the
# HTTPS origin of R2_PUBLIC_BASE_URL; it is allow-listed for image previews. Leave
# unset to disable previews (stored image records are unaffected).
CATALOG_MEDIA_BASE_URL=

# Optional browser API origin. Leave unset until a browser transport is approved.
NEXT_PUBLIC_API_ORIGIN=

# Future Reverb browser connection values; Phase 19.3 does not subscribe.
NEXT_PUBLIC_REVERB_HOST=
NEXT_PUBLIC_REVERB_PORT=443
NEXT_PUBLIC_REVERB_SCHEME=https
NEXT_PUBLIC_REVERB_APP_KEY=
