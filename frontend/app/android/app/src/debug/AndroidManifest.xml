<manifest
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">
    <!-- The INTERNET permission is required for development. Specifically,
         the Flutter tool needs it to communicate with the running application
         to allow setting breakpoints, to provide hot reload, etc.
    -->
    <uses-permission android:name="android.permission.INTERNET"/>
     <!-- Debug-only: allows LOCAL development against http://10.0.2.2:8000 and
          http://127.0.0.1:8000. The main manifest explicitly disables this, so
          release builds keep cleartext traffic disabled by policy.
         ConfigValidator also rejects HTTP for STAGING and PRODUCTION, so this
         exception is limited to LOCAL debug development and must not be copied
         to the main/release manifest. -->
    <application
        android:allowBackup="false"
        android:usesCleartextTraffic="true"
        tools:replace="android:usesCleartextTraffic"/>
</manifest>
