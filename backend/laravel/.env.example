APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://127.0.0.1:8000
# Production: HTTPS URL, APP_DEBUG=false, SESSION_SECURE_COOKIE=true, and explicit ingress proxy CIDRs.
TRUSTED_PROXIES=

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
# For production, prefer LOG_CHANNEL=daily (rotated files, 14 days via LOG_DAILY_DAYS) to avoid unbounded growth.
# Example production: LOG_CHANNEL=daily
# LOG_DAILY_DAYS=14
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=mydbname
DB_USERNAME=myusername
DB_PASSWORD=
# Required for remote MySQL/MariaDB in production.
MYSQL_ATTR_SSL_CA=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

# Keep disabled until Reverb is configured for this environment.
BROADCAST_CONNECTION=log
REVERB_APP_ID= # generated by "php -r 'echo bin2hex(random_bytes(16)), PHP_EOL;'""
REVERB_APP_KEY=
REVERB_APP_SECRET=
REVERB_HOST=hello.example.com #  real domain
REVERB_PORT=8080 #change to 443
REVERB_SCHEME=http # change to https
REVERB_SERVER_HOST=wow.example.com # remain same 
REVERB_SERVER_PORT=8080 # remain same
REVERB_ALLOWED_ORIGINS=localhost # local browser host; production uses the public host only
REVERB_SCALING_ENABLED=false
FILESYSTEM_DISK=local
ATTACHMENTS_DISK=attachments
PRODUCT_IMAGE_DISK=r2
PRODUCT_IMAGE_MAX_BYTES=5242880
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
R2_REGION=auto
R2_PUBLIC_BASE_URL=https://pub-20ad593372b04704ae5e74f0c4bda810.r2.dev
# The URL above is a Cloudflare R2 PUBLIC DEVELOPMENT URL (rate-limited). It is for local
# development only; point R2_PUBLIC_BASE_URL at a real CDN/custom domain before production.
# COMMERCE_REQUEST_ONLY defaults to true when APP_ENV=production; set explicitly to override.
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379
# Required for remote Redis in production: rediss://user:password@host:6380
REDIS_URL=

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"
# Set to a verified address on the configured Resend domain before enabling email.
MAIL_REPLY_TO_ADDRESS=
MAIL_REPLY_TO_NAME="${APP_NAME}"
RESEND_API_KEY=
# Email notifications remain disabled until sender configuration is approved.
NOTIFICATION_EMAIL_ENABLED=false
NOTIFICATION_EMAIL_MAILER=resend
NOTIFICATION_EMAIL_MAX_ATTEMPTS=3
NOTIFICATION_EMAIL_STALE_AFTER_MINUTES=15
NOTIFICATION_BROADCAST_QUEUE=notifications-broadcast
# FCM HTTP v1. Token management (device registration) and customer notification
# fan-out are separate switches and both ship disabled. Enabling registration
# only lets a device be addressed; it never sends a customer notification.
NOTIFICATION_PUSH_ENABLED=false
NOTIFICATION_PUSH_REGISTRATION_ENABLED=false
NOTIFICATION_PUSH_DIAGNOSTIC_ENABLED=false
NOTIFICATION_PUSH_TIMEOUT_SECONDS=10
NOTIFICATION_PUSH_MAX_ATTEMPTS=3
# Deactivate devices inactive longer than this many days.
NOTIFICATION_PUSH_STALE_DEVICE_DAYS=90
FIREBASE_PROJECT_ID=
# Keep this service-account path outside the repository and never expose it to Flutter.
GOOGLE_APPLICATION_CREDENTIALS=
FCM_DIAGNOSTIC_TOKEN=
# Server-managed secret used to derive the device token fingerprint (HMAC-SHA-256).
# Defaults to APP_KEY. Rotating it requires every stored device row to be
# re-registered, because existing fingerprints no longer match.
PUSH_TOKEN_FINGERPRINT_KEY=

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

# Server-managed secret used to derive the guest-cart guest_token_digest (HMAC-SHA-256)
GUEST_CART_TOKEN_KEY=

CLERK_SECRET_KEY=
CLERK_PUBLISHABLE_KEY=
CLERK_JWT_KEY=
CLERK_ISSUER=
# Exact origins that may assert the Clerk token `azp` claim. Clerk compares the
# claim literally: a trailing slash, a localhost/127.0.0.1 alias, a scheme change
# or a port change is a different origin. Must list every frontend origin,
# including the admin app. Verify with `php artisan clerk:check-origins`.
CLERK_AUTHORIZED_PARTIES=http://localhost:3000,http://localhost:3001
CLERK_AUDIENCES=
# Exact frontend origins permitted to call this API from a browser.
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001
RATE_LIMIT_PRE_AUTH_PER_MINUTE=300
# Shared budget for POST /me/devices and DELETE /me/devices/{device}.
RATE_LIMIT_DEVICE_REGISTRATION_PER_MINUTE=20
MAX_AUTHORIZATION_HEADER_BYTES=4096
MAX_REQUEST_BODY_BYTES=6291456
MAX_JSON_BODY_BYTES=262144

# Required only when explicitly running the local/testing DevelopmentUserSeeder.
SEED_DEMO_PASSWORD=

VITE_APP_NAME="${APP_NAME}"
